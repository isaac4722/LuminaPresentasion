<?xml version="1.0" encoding="utf-8"?>
<!--
  FusionHP.Managed.Tests.csproj (SDK-style) — target net48.
  Arnés de tests propio (sin vstest); corre como exe normal.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FusionHP.Managed.Tests</RootNamespace>
    <AssemblyName>FusionHP.Managed.Tests</AssemblyName>
    <TargetFrameworks>net48</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AhpFormatTests.cs" />
    <Compile Include="ProgramaTestRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FusionHP.Managed\FusionHP.Managed.csproj">
      <Project>{A1B2C3D4-0001-0001-0001-000000000001}</Project>
      <Name>FusionHP.Managed</Name>
    </ProjectReference>
  </ItemGroup>

</Project>
