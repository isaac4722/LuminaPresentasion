<?xml version="1.0" encoding="utf-8"?>
<!--
  FusionHP.Managed.csproj (SDK-style) — target net48.
  Decision: usar solo net48. El doc técnico pedía dual net35+net48 pero
  SDK-style no soporta bien net35 con WinForms (Microsoft.NET.Sdk.WindowsDesktop
  no existe para net35), y old-style tiene un bug en MSBuild 17.x que
  impide el dual target.
  Pendiente: volver a habilitar net35 cuando se migre a SDK-style completo
  sin WinForms dependency en la capa compartida.
-->
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FusionHP.Managed</RootNamespace>
    <AssemblyName>FusionHP.Managed</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS0168;CS0219;CS0414</WarningsAsErrors>
    <ErrorReport>none</ErrorReport>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- SDK-style autoincluye *.cs; como ya los tenemos explícitos,
         desactivamos la inclusión automática de Compile items. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- SDK-style genera AssemblyInfo.cs automáticamente. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;RELEASE;NET48</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;NET48</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Forms\MainForm.cs" />
    <Compile Include="Forms\MainForm.Designer.cs" />
    <Compile Include="Forms\StudioForm.cs" />
    <Compile Include="Forms\StudioForm.Designer.cs" />
    <Compile Include="Forms\PresentForm.cs" />
    <Compile Include="Forms\PresentForm.Designer.cs" />
    <Compile Include="Forms\LibraryForm.cs" />
    <Compile Include="Forms\LibraryForm.Designer.cs" />
    <Compile Include="Forms\OperatorConsoleForm.cs" />
    <Compile Include="Forms\OperatorConsoleForm.Designer.cs" />
    <Compile Include="Forms\BibleQuickForm.cs" />
    <Compile Include="Forms\BibleQuickForm.Designer.cs" />
    <Compile Include="Forms\DiagnosticForm.cs" />
    <Compile Include="Forms\DiagnosticForm.Designer.cs" />
    <Compile Include="Ipc\IpcClient.cs" />
    <Compile Include="Interop\ImportadorPptx.cs" />
    <Compile Include="Data\AhpProgram.cs" />
    <Compile Include="Data\Scenario.cs" />
    <Compile Include="Data\Element.cs" />
    <Compile Include="Data\Theme.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

