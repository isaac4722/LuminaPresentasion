<?xml version="1.0" encoding="utf-8"?>
<!--
  FusionHP.Managed.csproj (SDK-style) — dual target net35+net48.
  El SDK-style csproj evita el bug de MSBuild 17.x con old-style +
  TargetFrameworks plural.
  SDK-style usa Microsoft.NET.Sdk, no el Microsoft.CSharp.targets viejo.
  Requiere MSBuild 17 / dotnet SDK; el CI los tiene vía microsoft/setup-msbuild@v2.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FusionHP.Managed</RootNamespace>
    <AssemblyName>FusionHP.Managed</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFrameworks>net35;net48</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS0168;CS0219;CS0414</WarningsAsErrors>
    <ErrorReport>none</ErrorReport>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- SDK-style autoincluye *.cs; como ya los tenemos explícitos,
         desactivamos la inclusión automática de Compile items. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- SDK-style genera AssemblyInfo.cs automáticamente. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\Debug\</OutputPath>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <DefineConstants>$(DefineConstants);NET48</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net35' ">
    <DefineConstants>$(DefineConstants);NET35</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Forms\MainForm.cs" />
    <Compile Include="Forms\MainForm.Designer.cs" />
    <Compile Include="Forms\StudioForm.cs" />
    <Compile Include="Forms\StudioForm.Designer.cs" />
    <Compile Include="Forms\PresentForm.cs" />
    <Compile Include="Forms\PresentForm.Designer.cs" />
    <Compile Include="Forms\LibraryForm.cs" />
    <Compile Include="Forms\LibraryForm.Designer.cs" />
    <Compile Include="Forms\OperatorConsoleForm.cs" />
    <Compile Include="Forms\OperatorConsoleForm.Designer.cs" />
    <Compile Include="Forms\BibleQuickForm.cs" />
    <Compile Include="Forms\BibleQuickForm.Designer.cs" />
    <Compile Include="Forms\DiagnosticForm.cs" />
    <Compile Include="Forms\DiagnosticForm.Designer.cs" />
    <Compile Include="Ipc\IpcClient.cs" />
    <Compile Include="Data\AhpProgram.cs" />
    <Compile Include="Data\Scenario.cs" />
    <Compile Include="Data\Element.cs" />
    <Compile Include="Data\Theme.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
